{
  "name": "geomatricula",
  "version": "0.1.0",
  "private": true,
  "description": "GeoMatrícula — Plataforma de Inteligência Territorial e Registral",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run dev --workspace @geomatricula/api",
    "dev:web": "npm run dev --workspace @geomatricula/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "db:setup": "npm run db:setup --workspace @geomatricula/api",
    "db:seed": "npm run db:seed --workspace @geomatricula/api"
  },
  "engines": {
    "node": ">=20"
  }
}
