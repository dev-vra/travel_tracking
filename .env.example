# ----- Banco de dados (PostgreSQL + PostGIS) -----
DATABASE_URL="postgresql://geomatricula:geomatricula@localhost:5432/geomatricula?schema=public"

# ----- Filas (Redis / BullMQ) -----
REDIS_HOST="localhost"
REDIS_PORT="6379"

# ----- API -----
API_PORT="3333"
# Origens permitidas no CORS (separadas por vírgula)
CORS_ORIGINS="http://localhost:3000"

# ----- IA / OCR (AWS Bedrock — mockado nesta fase) -----
# Use OCR_PROVIDER=mock para rodar sem credenciais AWS.
# Troque para "bedrock" quando integrar de verdade (sa-east-1).
OCR_PROVIDER="mock"
AWS_REGION="sa-east-1"
BEDROCK_MODEL_ID="amazon.nova-pro-v1:0"

# ----- Frontend (Next.js) -----
NEXT_PUBLIC_API_URL="http://localhost:3333"
